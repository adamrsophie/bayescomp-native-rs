TARGET_DIR = $(CURDIR)/rust/target
LIBDIR = $(TARGET_DIR)/release
STATLIB = $(LIBDIR)/libbcn_ffi.a
# system libraries LLVM needs, reported by rustc when the static library is built
PKG_LIBS = -L$(LIBDIR) -lbcn_ffi @LDIRS@ $(shell cat "$(LIBDIR)/native-libs.txt" 2>/dev/null)

all: $(SHLIB) rust_clean

$(SHLIB): $(STATLIB)

$(STATLIB):
	PATH="$(PATH):$(HOME)/.cargo/bin" @SYSVAR@="@PREFIX@" cargo rustc --release --locked --manifest-path=rust/Cargo.toml --target-dir "$(TARGET_DIR)" -p bcn-ffi --features @FEATURE@ -- --print native-static-libs 2> "$(CURDIR)/cargo.log" || (cat "$(CURDIR)/cargo.log"; exit 1)
	sed -n "s/.*native-static-libs: //p" "$(CURDIR)/cargo.log" | tail -n 1 > "$(LIBDIR)/native-libs.txt"

rust_clean: $(SHLIB)
	rm -Rf "$(TARGET_DIR)" "$(CURDIR)/cargo.log"

.PHONY: all rust_clean
